# Supabase-project van Toolen (niet het Publitool-project)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>   # of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

# Hoofddomein en cookie voor één login over alle organisaties
NEXT_PUBLIC_HOOFDDOMEIN=toolen.be
NEXT_PUBLIC_COOKIE_DOMAIN=.toolen.be

# Lokaal en op previews (geen subdomein per klant): standaardorganisatie
TOOLEN_STANDAARD_ORG=flcs

# Optioneel: Esri-luchtfoto buiten BE/NL
NEXT_PUBLIC_ESRI_SLEUTEL=
